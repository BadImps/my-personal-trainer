<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: use the same premium trainer mark as the
         launcher icon rather than the platform's generic Android placeholder. -->
    <style name="AppTheme.Starting" parent="@style/AppTheme">
        <item name="android:windowSplashScreenBackground">@color/navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/navy</item>
    </style>
</resources>
