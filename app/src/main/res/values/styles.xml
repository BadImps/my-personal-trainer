<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/coral</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <!-- Prevent a light window from appearing for a frame while a selector redraws. -->
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The API 31+ implementation lives in values-v31. This fallback keeps launch
         surfaces navy on older devices instead of briefly showing a white window. -->
    <style name="AppTheme.Starting" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/navy</item>
    </style>
</resources>
