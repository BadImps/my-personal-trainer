<?xml version="1.0" encoding="utf-8"?>
<!-- Local profile, body, route, and workout history remain on this device unless the person
     explicitly exports them. This preserves the app's existing no-cloud-backup promise. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
